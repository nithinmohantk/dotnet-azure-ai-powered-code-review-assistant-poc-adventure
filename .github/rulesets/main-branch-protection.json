{
  "name": "Main Branch Protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 2,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "build", "integration_id": null},
          {"context": "unit-tests", "integration_id": null},
          {"context": "integration-tests", "integration_id": null},
          {"context": "e2e-tests", "integration_id": null},
          {"context": "code-quality / sonarcloud", "integration_id": null},
          {"context": "security / sast", "integration_id": null},
          {"context": "security / dependency-check", "integration_id": null},
          {"context": "security / container-scan", "integration_id": null},
          {"context": "security / secrets-scan", "integration_id": null},
          {"context": "security / codeql", "integration_id": null},
          {"context": "architecture-tests", "integration_id": null},
          {"context": "performance-tests", "integration_id": null},
          {"context": "terraform / validate", "integration_id": null},
          {"context": "terraform / security", "integration_id": null},
          {"context": "license-check", "integration_id": null}
        ]
      }
    },
    {
      "type": "required_signatures",
      "parameters": {}
    },
    {
      "type": "required_linear_history",
      "parameters": {}
    },
    {
      "type": "deletion",
      "parameters": {}
    },
    {
      "type": "non_fast_forward",
      "parameters": {}
    },
    {
      "type": "creation",
      "parameters": {}
    }
  ],
  "bypass_actors": []
}
